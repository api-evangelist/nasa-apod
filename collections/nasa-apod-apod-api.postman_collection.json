  "info": {
    "_postman_id": "8f751066-356a-43b4-a1aa-ff182d5ac4c8",
    "name": "NASA Astronomy Picture of the Day () APOD API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "NASA Astronomy Picture of the Day (APOD) REST API providing daily astronomy images and explanations curated by NASA scientists. Supports retrieval by specific date, date ranges, and random selection, with high-definition image URLs, media type detection, and optional concept tags derived from image metadata. Data is available from 1995-06-16 onward.\n\n\nContact Support:\n Name: NASA API Support",
      "type": "text/plain"
    }
  }
